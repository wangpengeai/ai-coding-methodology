{
  "name": "ai-coding-methodology",
  "version": "1.0.0",
  "type": "module",
  "description": "Bring six AI coding methodology plugins (workflow engine, spec gating, exploration mode, team governance, algorithm iteration, research loop) from ZCode into DeepSeek Harness — hooks, skills, commands and agents, with the ZCode side left untouched.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "zcode",
    "ai-coding",
    "methodology",
    "plugin-adapter",
    "agent-skills"
  ],
  "license": "MIT",
  "author": "wangp",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./log": "./src/log.mjs",
    "./hooks-bridge": "./src/hooks-bridge.mjs",
    "./skills-bridge": "./src/skills-bridge.mjs",
    "./commands-bridge": "./src/commands-bridge.mjs",
    "./agents-bridge": "./src/agents-bridge.mjs",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./client": "./client/client.js"
  },
  "files": [
    "src/**/*.mjs",
    "client/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-shell": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-subagent": ">=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-subagent": {
      "optional": true
    }
  },
  "devDependencies": {
    "js-yaml": "^5.4.2"
  }
}
