{
  "manifestVersion": 1,
  "name": "spec-gate",
  "version": "1.0.0",
  "description": "规格资产治理与机器校验：规则注册表、模板、台账、证据捕获与 plan 校验门禁，含 SDD/DDD/TDD 适用性判定与聚合门禁 —— 触发条件：项目含 .sdd/ 体系时的规格写作、体系回填、门禁校验与证据捕获。",
  "displayName": "AI Coding 方法论 · 规格门禁",
  "author": "wangp",
  "hooks": [
    { "event": "SessionStart", "matcher": "startup|resume|clear|compact", "type": "process", "command": "node", "args": ["${PLUGIN_ROOT}/hooks/session-start.mjs"], "timeoutMs": 15000, "statusMessage": "SDD 台账检查" },
    { "event": "PostToolUse", "matcher": "Write|Edit", "type": "process", "command": "node", "args": ["${PLUGIN_ROOT}/hooks/post-tool-use.mjs"], "timeoutMs": 30000, "statusMessage": "SDD 规格校验" }
  ]
}
