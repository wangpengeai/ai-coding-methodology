{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.manifest",
  "title": "Methodology core manifest",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string" },
    "compatibilityRange": { "type": "string" },
    "publicAssets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "assetId": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["schema", "template", "validator", "fixture", "reference"]
          },
          "path": { "type": "string" },
          "version": { "type": "string" },
          "sha256": { "type": "string" },
          "deprecated": { "type": "boolean" },
          "supersededBy": { "type": ["string", "null"] }
        },
        "required": ["assetId", "kind", "path", "version", "sha256", "deprecated", "supersededBy"]
      }
    },
    "ruleRegistry": {
      "type": "object",
      "properties": {
        "assetId": { "type": "string" },
        "path": { "type": "string" }
      },
      "required": ["assetId", "path"]
    },
    "deprecationMappings": { "type": "array", "items": { "type": "object" } },
    "retiredRuleIds": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["schemaVersion", "compatibilityRange", "publicAssets", "ruleRegistry", "deprecationMappings", "retiredRuleIds"]
}
