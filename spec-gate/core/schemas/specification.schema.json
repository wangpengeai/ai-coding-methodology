{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.specification",
  "title": "Atomic specification envelope",
  "description": "规格条目的唯一权威结构。编号在各自族内全局唯一：FR-域-n、NFR-域-n、R-n、D-n、T-n、G-Tn、AC-n。全局时序只允许唯一 G-T 主编号，模块条目只能标注细化。",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^FR-[A-Za-z0-9]+-\\d+$" },
          "statement": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "status": { "type": "string", "enum": ["proposed", "accepted", "deferred", "rejected"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "statement", "priority", "status"]
      }
    },
    "nonFunctionalRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^NFR-[A-Za-z0-9]+-\\d+$" },
          "category": { "type": "string", "minLength": 1 },
          "currentValue": { "type": "string" },
          "targetValue": { "type": "string" },
          "measurementMethod": { "type": "string" }
        },
        "required": ["id", "category", "targetValue"]
      }
    },
    "moduleRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^R-\\d+$" },
          "statement": { "type": "string", "minLength": 1 },
          "tracesTo": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "required": ["id", "statement", "tracesTo"]
      }
    },
    "externalContracts": {
      "deprecated": true,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "operations": { "type": "array", "items": { "type": "string" } },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "postconditions": { "type": "array", "items": { "type": "string" } },
          "errorSemantics": { "type": "array", "items": { "type": "string" } },
          "riskTriggeredDetails": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "operations", "errorSemantics"]
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^IF-[A-Za-z0-9]+-\\d+$" },
          "kind": { "type": "string", "enum": ["external", "inter-module"] },
          "ownerModule": { "type": "string", "minLength": 1 },
          "consumerModules": { "type": "array", "items": { "type": "string" } },
          "operations": { "type": "array", "items": { "type": "string" } },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "postconditions": { "type": "array", "items": { "type": "string" } },
          "errorSemantics": { "type": "array", "items": { "type": "string" } },
          "riskTriggeredDetails": { "type": "array", "items": { "type": "string" } },
          "lifecycle": { "type": "string", "enum": ["proposed", "active", "deprecated", "retired"] },
          "deprecation": {
            "type": ["object", "null"],
            "properties": {
              "deadline": { "type": "string" },
              "successor": { "type": ["string", "null"] },
              "migrationNote": { "type": "string" }
            },
            "required": ["deadline", "migrationNote"]
          },
          "version": { "type": "string", "minLength": 1 },
          "compatPolicy": { "type": "string", "enum": ["strict-backward", "rolling", "pinned"] },
          "contractArtifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "artifactType": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "contentHash": { "type": "string" },
                "driftCheckCommand": { "type": "string" }
              },
              "required": ["artifactType", "path"]
            }
          },
          "tracesTo": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "kind", "ownerModule", "consumerModules", "operations", "errorSemantics", "lifecycle", "version", "compatPolicy", "tracesTo"]
      }
    },
    "designDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^D-\\d+$" },
          "statement": { "type": "string", "minLength": 1 },
          "adrRef": { "type": ["string", "null"] }
        },
        "required": ["id", "statement"]
      }
    },
    "moduleSequences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^T-\\d+$" },
          "refines": { "type": ["string", "null"], "pattern": "^(G-T\\d+)?$" },
          "obligations": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        },
        "required": ["id", "obligations"]
      }
    },
    "globalSequences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^G-T\\d+$" },
          "statement": { "type": "string", "minLength": 1 },
          "participatingModules": { "type": "array", "minItems": 2, "items": { "type": "string" } }
        },
        "required": ["id", "statement", "participatingModules"]
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "prohibited": { "type": "array", "items": { "type": "string" } },
          "required": { "type": "array", "items": { "type": "string" } },
          "verifiableCondition": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "verifiableCondition"]
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[A-Za-z0-9]+-\\d+$|^AC-\\d+$" },
          "behavior": { "type": "string", "minLength": 1 },
          "tracesTo": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "lockMethod": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "behavior", "tracesTo", "lockMethod"]
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "definition": { "type": "string", "minLength": 1 },
          "syncTargets": { "type": "array", "items": { "type": "string", "enum": ["code", "spec", "tests"] } }
        },
        "required": ["term", "definition", "syncTargets"]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^A\\d+$" },
          "statement": { "type": "string", "minLength": 1 },
          "invalidationClause": { "type": "string" }
        },
        "required": ["id", "statement"]
      }
    }
  },
  "required": ["schemaVersion"]
}
