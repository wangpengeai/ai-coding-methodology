{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/session-start.mjs"],
            "timeoutMs": 20000,
            "statusMessage": "team-governance 治理摘要（含 os-observe 补位采集）"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/pre-tool-use.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "team-governance 租约护栏（显式启用）"
          }
        ]
      }
    ]
  }
}
