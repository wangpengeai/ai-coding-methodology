{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/session-start.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "workflow 元技能注入"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/user-prompt.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "workflow 路由提醒"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/task-recap.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "自察收尾提醒"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/learnings-recap.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "learnings 沉淀提醒"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/verify-gate.mjs"],
            "timeoutMs": 60000,
            "statusMessage": "verify-gate 完成闸"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/check-careful.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "危险命令护栏"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/check-freeze.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "编辑冻结护栏"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/routing-gate.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "任务租约闸"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/write-guard.mjs"],
            "timeoutMs": 2000,
            "statusMessage": "写仓闸（enforce）"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/post-tool.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "自察捕获（工具失败主通道）"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/post-tool.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "自察捕获（防御解析兜底）"
          }
        ]
      }
    ]
  }
}
