{
  "rulesVersion": 2,
  "rules": [
    { "id": "command-to-skill", "title": "命令面以 skill 承接", "trigger": { "capability": "surface.commands", "gap": false }, "strategy": "emulate", "params": { "mcode": { "form": "same-name-skill", "note": "薄指针同名覆盖、操作型物化为同名 skill 并标注来源命令" } }, "fidelity": "lossy", "sourceRef": ["ADR-034 决策 8"] },
    { "id": "followup-expansion", "title": "followup 补回提示词展开", "trigger": { "capability": "command.promptExpansion", "gap": "none" }, "strategy": "emulate", "params": { "dsh": { "api": "agent.followup", "fallback": "receipt-no-drive" } }, "fidelity": "lossy", "sourceRef": ["ADR-032 决策 9"] },
    { "id": "agent-default-off-fail-closed", "title": "agent 面默认关闭 + 目录不可得拒挂", "trigger": { "capability": "surface.agents", "gap": "optional" }, "strategy": "disable", "params": { "dsh": { "defaultMount": false, "unknownTool": "reject" }, "mcode": { "defaultMount": false, "unknownTool": "reject" }, "kimi": { "defaultMount": false, "unknownTool": "reject" } }, "fidelity": "degraded", "sourceRef": ["ADR-032 决策 7", "ADR-034 决策 9", "ADR-038 决策 5"] },
    { "id": "message-slot-migration", "title": "危险文案位迁移", "trigger": { "capability": "hook.envelope.systemMessage", "gap": false }, "strategy": "map", "params": { "dsh": { "readPriority": ["permissionDecisionReason", "systemMessage"] }, "mcode": { "rename": { "systemMessage": "permissionDecisionReason" } }, "kimi": { "rename": { "systemMessage": "permissionDecisionReason" } } }, "fidelity": "lossy", "sourceRef": ["ADR-034 决策 5 表 row 3", "ADR-032 背景六处差异", "ADR-038 差异面 row 1/11"] },
    { "id": "failure-event-merge", "title": "失败事件合并", "trigger": { "capability": "hook.events", "gap": "PostToolUseFailure" }, "strategy": "normalize", "params": { "dsh": { "into": "PostToolUse", "synthesize": ["is_error", "exit_code", "stdout"], "constants": { "stderr": "" } }, "mcode": { "into": "PostToolUse", "synthesize": ["is_error", "exit_code", "stdout"], "constants": { "stderr": "" } } }, "fidelity": "lossy", "sourceRef": ["ADR-034 决策 5 表 row 4"] },
    { "id": "stop-pending-relay", "title": "Stop 非阻断注入待投递中继", "trigger": { "capability": "hook.stop.nonBlockingSlot", "gap": "none" }, "strategy": "relay", "params": { "mcode": { "store": "PLUGIN_DATA", "deliverOn": "UserPromptSubmit", "triggerEvent": "Stop", "burstCap": 3, "pendingLimit": 20, "capNote": "（完成闸续跑已达连击上限，降级为待投递提醒）" }, "kimi": { "store": "$KIMI_CODE_HOME/plugin-data/<id>", "deliverOn": "UserPromptSubmit", "relayEvents": ["Stop", "SessionStart", "PostToolUse", "PostToolUseFailure"], "burstCap": 3, "pendingLimit": 20, "capNote": "（完成闸续跑已达连击上限，降级为待投递提醒）" } }, "fidelity": "degraded", "sourceRef": ["ADR-034 决策 5 表 row 5", "ADR-034 决策 7", "ADR-038 决策 4"] },
    { "id": "timeout-cap-fail-open", "title": "超时封顶降级 fail-open", "trigger": { "capability": "hook.timeout.maxSeconds", "gap": "below-declared" }, "strategy": "degrade", "params": { "mcode": { "cap": "host-max", "onTimeout": "kill-fail-open-remind", "minSeconds": 1, "maxSeconds": 10, "defaultSeconds": 5, "marginMs": 800, "minBudgetMs": 1000 } }, "fidelity": "degraded", "sourceRef": ["ADR-034 决策 6"] },
    { "id": "source-widen-normalize", "title": "域外会话来源归一取宽", "trigger": { "capability": "session.sources", "gap": "out-of-vocabulary" }, "strategy": "normalize", "params": { "dsh": { "to": "startup", "accepted": ["startup", "resume", "clear", "compact"] }, "mcode": { "to": "startup", "accepted": ["startup", "resume", "clear", "compact"] }, "kimi": { "to": "startup", "accepted": ["startup", "resume"] } }, "fidelity": "lossy", "sourceRef": ["ADR-032 决策 6", "ADR-034 决策 5 表 row 6", "ADR-038 差异面 row 10"] },
    { "id": "tool-vocab-map", "title": "工具名词表映射", "trigger": { "capability": "toolName.vocabulary", "gap": "differs" }, "strategy": "map", "params": { "dsh": { "direction": "widen", "table": { "Bash": ["pwsh", "bash", "Bash"], "Edit": ["edit", "str_replace_editor", "Edit"], "Write": ["write", "Write"] } }, "mcode": { "direction": "one-to-one", "table": { "Bash": ["bash"], "Edit": ["edit"], "Write": ["write"] } } }, "fidelity": "lossy", "sourceRef": ["ADR-032 决策 6", "ADR-034 决策 5 表 row 2"] },
    { "id": "namespace-transform", "title": "命名空间变形", "trigger": { "capability": "namespace.separator", "gap": "differs" }, "strategy": "map", "params": { "dsh": { "separator": "-", "collision": "first-wins-warn", "prefix": "plugin-name" } }, "fidelity": "lossy", "sourceRef": ["ADR-032 决策 8"] }
  ]
}
